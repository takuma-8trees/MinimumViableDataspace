services:
  # PostgreSQL databases
  postgres-consumer:
    image: postgres:16-alpine
    container_name: mvd-postgres-consumer
    environment:
      POSTGRES_DB: consumer
      POSTGRES_USER: consumer
      POSTGRES_PASSWORD: consumer
    ports:
      - "5432:5432"
    volumes:
      - postgres-consumer-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U consumer"]
      interval: 10s
      timeout: 5s
      retries: 5

  postgres-provider:
    image: postgres:16-alpine
    container_name: mvd-postgres-provider
    environment:
      POSTGRES_DB: provider
      POSTGRES_USER: provider
      POSTGRES_PASSWORD: provider
    ports:
      - "5433:5432"
    volumes:
      - postgres-provider-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U provider"]
      interval: 10s
      timeout: 5s
      retries: 5

  postgres-issuer:
    image: postgres:16-alpine
    container_name: mvd-postgres-issuer
    environment:
      POSTGRES_DB: issuer
      POSTGRES_USER: issuer
      POSTGRES_PASSWORD: issuer
    ports:
      - "5434:5432"
    volumes:
      - postgres-issuer-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U issuer"]
      interval: 10s
      timeout: 5s
      retries: 5

  # HashiCorp Vault
  vault:
    image: hashicorp/vault:1.17
    container_name: mvd-vault
    ports:
      - "8200:8200"
    environment:
      VAULT_DEV_ROOT_TOKEN_ID: "root"
      VAULT_DEV_LISTEN_ADDRESS: "0.0.0.0:8200"
      VAULT_ADDR: "http://127.0.0.1:8200"
    cap_add:
      - IPC_LOCK
    healthcheck:
      test: ["CMD", "vault", "status"]
      interval: 10s
      timeout: 5s
      retries: 5

  # NGINX for issuer DID document
  nginx-issuer:
    image: nginx:alpine
    container_name: mvd-nginx-issuer
    ports:
      - "9876:80"
    volumes:
      - ./deployment/assets/issuer/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./deployment/assets/issuer/did.docker.json:/var/www/.well-known/did.json:ro
    healthcheck:
      test: ["CMD", "sh", "-c", "wget -O- http://127.0.0.1/.well-known/did.json > /dev/null 2>&1"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Issuer Service
  issuer-service:
    build:
      context: .
      dockerfile: launchers/issuerservice/src/main/docker/Dockerfile
      args:
        JAR: launchers/issuerservice/build/libs/issuerservice.jar
    container_name: mvd-issuer-service
    ports:
      - "8091:8091"
    environment:
      WEB_HTTP_PORT: "8091"
      WEB_HTTP_PATH: "/api"
      EDC_ISSUER_STATUSLIST_SIGNING_KEY_ALIAS: "signing-key-alias"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IH_API_SUPERUSER_KEY: "c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo="
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-issuer:5432/issuer"
      EDC_DATASOURCE_DEFAULT_USER: "issuer"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "issuer"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
    depends_on:
      postgres-issuer:
        condition: service_healthy
      vault:
        condition: service_healthy
      nginx-issuer:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8091/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Consumer Identity Hub
  consumer-identityhub:
    build:
      context: .
      dockerfile: launchers/identity-hub/src/main/docker/Dockerfile
      args:
        JAR: launchers/identity-hub/build/libs/identity-hub.jar
    container_name: mvd-consumer-identityhub
    ports:
      - "7080:7080"
      - "7081:7081"
      - "7082:7082"
      - "7083:7083"
      - "7085:7085"
      - "7086:7086"
    volumes:
      - ./deployment/assets/credentials/local/consumer:/credentials:ro
      - ./deployment/assets/consumer_public.pem:/consumer_public.pem:ro
    environment:
      WEB_HTTP_PORT: "7080"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_CREDENTIALS_PORT: "7081"
      WEB_HTTP_CREDENTIALS_PATH: "/api/credentials"
      WEB_HTTP_IDENTITY_PORT: "7082"
      WEB_HTTP_IDENTITY_PATH: "/api/identity"
      WEB_HTTP_DID_PORT: "7083"
      WEB_HTTP_DID_PATH: "/"
      WEB_HTTP_VERSION_PORT: "7085"
      WEB_HTTP_VERSION_PATH: "/api/version"
      WEB_HTTP_STS_PORT: "7086"
      WEB_HTTP_STS_PATH: "/api/sts"
      EDC_PARTICIPANT_ID: "did:web:consumer-identityhub:7083"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "key-1"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:consumer-identityhub:7083#key-1"
      EDC_IH_IAM_PUBLICKEY_PATH: "/consumer_public.pem"
      EDC_IH_IAM_ID: "did:web:consumer-identityhub:7083"
      EDC_IH_API_SUPERUSER_KEY: "c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo="
      EDC_MVD_CREDENTIALS_PATH: "/credentials/"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-consumer:5432/consumer"
      EDC_DATASOURCE_DEFAULT_USER: "consumer"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "consumer"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
    depends_on:
      postgres-consumer:
        condition: service_healthy
      vault:
        condition: service_healthy
      issuer-service:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:7080/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Consumer Connector (Control Plane + Data Plane)
  consumer-connector:
    build:
      context: .
      dockerfile: launchers/controlplane/src/main/docker/Dockerfile
      args:
        JAR: launchers/controlplane/build/libs/controlplane.jar
    container_name: mvd-consumer-connector
    ports:
      - "9080:9080"  # Default API (changed from 8080 due to conflict)
      - "9081:9081"  # Management API
      - "9082:9082"  # DSP Protocol API
      - "9083:9083"  # Control API
      - "9084:9084"  # Catalog API
      - "9085:9085"  # Version API
      - "11001:11001"  # Data Plane Public API
    volumes:
      - ./deployment/assets/participants/participants.local.json:/app/participants.json:ro
    environment:
      WEB_HTTP_PORT: "9080"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_MANAGEMENT_PORT: "9081"
      WEB_HTTP_MANAGEMENT_PATH: "/api/management/"
      WEB_HTTP_MANAGEMENT_AUTH_TYPE: "tokenbased"
      WEB_HTTP_MANAGEMENT_AUTH_KEY: "password"
      WEB_HTTP_PROTOCOL_PORT: "9082"
      WEB_HTTP_PROTOCOL_PATH: "/api/dsp"
      WEB_HTTP_CONTROL_PORT: "9083"
      WEB_HTTP_CONTROL_PATH: "/api/control"
      WEB_HTTP_CATALOG_PORT: "9084"
      WEB_HTTP_CATALOG_PATH: "/api/catalog"
      WEB_HTTP_CATALOG_AUTH_TYPE: "tokenbased"
      WEB_HTTP_CATALOG_AUTH_KEY: "password"
      WEB_HTTP_VERSION_PORT: "9085"
      WEB_HTTP_VERSION_PATH: "/api/version"
      WEB_HTTP_PUBLIC_PORT: "11001"
      WEB_HTTP_PUBLIC_PATH: "/api/public"
      EDC_PARTICIPANT_ID: "did:web:consumer-identityhub:7083"
      EDC_IAM_ISSUER_ID: "did:web:consumer-identityhub:7083"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "did:web:consumer-identityhub:7083-alias"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:consumer-identityhub:7083#key-1"
      EDC_DSP_CALLBACK_ADDRESS: "http://consumer-connector:9082/api/dsp"
      EDC_CATALOG_CACHE_EXECUTION_DELAY_SECONDS: "5"
      EDC_CATALOG_CACHE_EXECUTION_PERIOD_SECONDS: "10"
      EDC_MVD_PARTICIPANTS_LIST_FILE: "/app/participants.json"
      EDC_MANAGEMENT_CONTEXT_ENABLED: "true"
      EDC_RUNTIME_ID: "consumer-embedded-runtime"
      EDC_TRANSFER_PROXY_TOKEN_VERIFIER_PUBLICKEY_ALIAS: "did:web:consumer-identityhub:7083#key-1"
      EDC_TRANSFER_PROXY_TOKEN_SIGNER_PRIVATEKEY_ALIAS: "did:web:consumer-identityhub:7083-alias"
      EDC_DPF_SELECTOR_URL: "http://localhost:9083/api/control/v1/dataplanes"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-consumer:5432/consumer"
      EDC_DATASOURCE_DEFAULT_USER: "consumer"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "consumer"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
      EDC_IAM_STS_OAUTH_TOKEN_URL: "http://consumer-identityhub:7086/api/sts/token"
      EDC_IAM_STS_OAUTH_CLIENT_ID: "did:web:consumer-identityhub:7083"
      EDC_IAM_STS_OAUTH_CLIENT_SECRET_ALIAS: "did:web:consumer-identityhub:7083-sts-client-secret"
    depends_on:
      consumer-identityhub:
        condition: service_healthy
      postgres-consumer:
        condition: service_healthy
      vault:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9080/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Provider Identity Hub
  provider-identityhub:
    build:
      context: .
      dockerfile: launchers/identity-hub/src/main/docker/Dockerfile
      args:
        JAR: launchers/identity-hub/build/libs/identity-hub.jar
    container_name: mvd-provider-identityhub
    ports:
      - "7090:7090"
      - "7091:7091"
      - "7092:7092"
      - "7093:7093"
      - "7095:7095"
      - "7096:7096"
    volumes:
      - ./deployment/assets/credentials/local/provider:/credentials:ro
      - ./deployment/assets/provider_public.pem:/provider_public.pem:ro
    environment:
      WEB_HTTP_PORT: "7090"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_CREDENTIALS_PORT: "7091"
      WEB_HTTP_CREDENTIALS_PATH: "/api/credentials"
      WEB_HTTP_IDENTITY_PORT: "7092"
      WEB_HTTP_IDENTITY_PATH: "/api/identity"
      WEB_HTTP_DID_PORT: "7093"
      WEB_HTTP_DID_PATH: "/"
      WEB_HTTP_VERSION_PORT: "7095"
      WEB_HTTP_VERSION_PATH: "/api/version"
      WEB_HTTP_STS_PORT: "7096"
      WEB_HTTP_STS_PATH: "/api/sts"
      EDC_PARTICIPANT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "key-1"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:provider-identityhub:7093#key-1"
      EDC_IH_IAM_PUBLICKEY_PATH: "/provider_public.pem"
      EDC_IH_IAM_ID: "did:web:provider-identityhub:7093"
      EDC_IH_API_SUPERUSER_KEY: "c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo="
      EDC_MVD_CREDENTIALS_PATH: "/credentials/"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-provider:5432/provider"
      EDC_DATASOURCE_DEFAULT_USER: "provider"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "provider"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
    depends_on:
      postgres-provider:
        condition: service_healthy
      vault:
        condition: service_healthy
      issuer-service:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:7090/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Provider Connector - QnA
  provider-connector-qna:
    build:
      context: .
      dockerfile: launchers/controlplane/src/main/docker/Dockerfile
      args:
        JAR: launchers/controlplane/build/libs/controlplane.jar
    container_name: mvd-provider-connector-qna
    ports:
      - "8190:8190"  # Default API
      - "8191:8191"  # Management API
      - "8192:8192"  # DSP Protocol API
      - "8193:8193"  # Control API
      - "8194:8194"  # Catalog API
      - "8195:8195"  # Version API
      - "12001:12001"  # Data Plane Public API
    volumes:
      - ./deployment/assets/participants/participants.local.json:/app/participants.json:ro
    environment:
      WEB_HTTP_PORT: "8190"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_MANAGEMENT_PORT: "8191"
      WEB_HTTP_MANAGEMENT_PATH: "/api/management/"
      WEB_HTTP_MANAGEMENT_AUTH_TYPE: "tokenbased"
      WEB_HTTP_MANAGEMENT_AUTH_KEY: "password"
      WEB_HTTP_PROTOCOL_PORT: "8192"
      WEB_HTTP_PROTOCOL_PATH: "/api/dsp"
      WEB_HTTP_CONTROL_PORT: "8193"
      WEB_HTTP_CONTROL_PATH: "/api/control"
      WEB_HTTP_CATALOG_PORT: "8194"
      WEB_HTTP_CATALOG_PATH: "/api/catalog"
      WEB_HTTP_CATALOG_AUTH_TYPE: "tokenbased"
      WEB_HTTP_CATALOG_AUTH_KEY: "password"
      WEB_HTTP_VERSION_PORT: "8195"
      WEB_HTTP_VERSION_PATH: "/api/version"
      WEB_HTTP_PUBLIC_PORT: "12001"
      WEB_HTTP_PUBLIC_PATH: "/api/public"
      EDC_PARTICIPANT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_ISSUER_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "did:web:provider-identityhub:7093-alias"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:provider-identityhub:7093#key-1"
      EDC_DSP_CALLBACK_ADDRESS: "http://provider-connector-qna:8192/api/dsp"
      EDC_CATALOG_CACHE_EXECUTION_DELAY_SECONDS: "5"
      EDC_CATALOG_CACHE_EXECUTION_PERIOD_SECONDS: "10"
      EDC_MVD_PARTICIPANTS_LIST_FILE: "/app/participants.json"
      EDC_MANAGEMENT_CONTEXT_ENABLED: "true"
      EDC_RUNTIME_ID: "provider-qna-embedded-runtime"
      EDC_TRANSFER_PROXY_TOKEN_VERIFIER_PUBLICKEY_ALIAS: "did:web:provider-identityhub:7093#key-1"
      EDC_TRANSFER_PROXY_TOKEN_SIGNER_PRIVATEKEY_ALIAS: "did:web:provider-identityhub:7093-alias"
      EDC_DPF_SELECTOR_URL: "http://localhost:8193/api/control/v1/dataplanes"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-provider:5432/provider"
      EDC_DATASOURCE_DEFAULT_USER: "provider"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "provider"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
      EDC_IAM_STS_OAUTH_TOKEN_URL: "http://provider-identityhub:7096/api/sts/token"
      EDC_IAM_STS_OAUTH_CLIENT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_STS_OAUTH_CLIENT_SECRET_ALIAS: "did:web:provider-identityhub:7093-sts-client-secret"
    depends_on:
      provider-identityhub:
        condition: service_healthy
      postgres-provider:
        condition: service_healthy
      vault:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8190/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Provider Connector - Manufacturing
  provider-connector-manufacturing:
    build:
      context: .
      dockerfile: launchers/controlplane/src/main/docker/Dockerfile
      args:
        JAR: launchers/controlplane/build/libs/controlplane.jar
    container_name: mvd-provider-connector-manufacturing
    ports:
      - "8290:8290"  # Default API
      - "8291:8291"  # Management API
      - "8292:8292"  # DSP Protocol API
      - "8293:8293"  # Control API
      - "8294:8294"  # Catalog API
      - "8295:8295"  # Version API
      - "12002:12002"  # Data Plane Public API
    volumes:
      - ./deployment/assets/participants/participants.local.json:/app/participants.json:ro
    environment:
      WEB_HTTP_PORT: "8290"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_MANAGEMENT_PORT: "8291"
      WEB_HTTP_MANAGEMENT_PATH: "/api/management/"
      WEB_HTTP_MANAGEMENT_AUTH_TYPE: "tokenbased"
      WEB_HTTP_MANAGEMENT_AUTH_KEY: "password"
      WEB_HTTP_PROTOCOL_PORT: "8292"
      WEB_HTTP_PROTOCOL_PATH: "/api/dsp"
      WEB_HTTP_CONTROL_PORT: "8293"
      WEB_HTTP_CONTROL_PATH: "/api/control"
      WEB_HTTP_CATALOG_PORT: "8294"
      WEB_HTTP_CATALOG_PATH: "/api/catalog"
      WEB_HTTP_CATALOG_AUTH_TYPE: "tokenbased"
      WEB_HTTP_CATALOG_AUTH_KEY: "password"
      WEB_HTTP_VERSION_PORT: "8295"
      WEB_HTTP_VERSION_PATH: "/api/version"
      WEB_HTTP_PUBLIC_PORT: "12002"
      WEB_HTTP_PUBLIC_PATH: "/api/public"
      EDC_PARTICIPANT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_ISSUER_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "did:web:provider-identityhub:7093-alias"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:provider-identityhub:7093#key-1"
      EDC_DSP_CALLBACK_ADDRESS: "http://provider-connector-manufacturing:8292/api/dsp"
      EDC_CATALOG_CACHE_EXECUTION_DELAY_SECONDS: "5"
      EDC_CATALOG_CACHE_EXECUTION_PERIOD_SECONDS: "10"
      EDC_MVD_PARTICIPANTS_LIST_FILE: "/app/participants.json"
      EDC_MANAGEMENT_CONTEXT_ENABLED: "true"
      EDC_RUNTIME_ID: "provider-manufacturing-embedded-runtime"
      EDC_TRANSFER_PROXY_TOKEN_VERIFIER_PUBLICKEY_ALIAS: "did:web:provider-identityhub:7093#key-1"
      EDC_TRANSFER_PROXY_TOKEN_SIGNER_PRIVATEKEY_ALIAS: "did:web:provider-identityhub:7093-alias"
      EDC_DPF_SELECTOR_URL: "http://localhost:8293/api/control/v1/dataplanes"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-provider:5432/provider"
      EDC_DATASOURCE_DEFAULT_USER: "provider"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "provider"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
      EDC_IAM_STS_OAUTH_TOKEN_URL: "http://provider-identityhub:7096/api/sts/token"
      EDC_IAM_STS_OAUTH_CLIENT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_STS_OAUTH_CLIENT_SECRET_ALIAS: "did:web:provider-identityhub:7093-sts-client-secret"
    depends_on:
      provider-identityhub:
        condition: service_healthy
      postgres-provider:
        condition: service_healthy
      vault:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8290/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

  # Provider Catalog Server
  provider-catalogserver:
    build:
      context: .
      dockerfile: launchers/catalog-server/src/main/docker/Dockerfile
      args:
        JAR: launchers/catalog-server/build/libs/catalog-server.jar
    container_name: mvd-provider-catalogserver
    ports:
      - "8180:8180"  # Default API
      - "8181:8181"  # Management API
      - "8182:8182"  # DSP Protocol API
      - "8184:8184"  # Catalog API
      - "8185:8185"  # Version API
    volumes:
      - ./deployment/assets/participants/participants.local.json:/app/participants.json:ro
    environment:
      WEB_HTTP_PORT: "8180"
      WEB_HTTP_PATH: "/api"
      WEB_HTTP_MANAGEMENT_PORT: "8181"
      WEB_HTTP_MANAGEMENT_PATH: "/api/management/"
      WEB_HTTP_MANAGEMENT_AUTH_TYPE: "tokenbased"
      WEB_HTTP_MANAGEMENT_AUTH_KEY: "password"
      WEB_HTTP_PROTOCOL_PORT: "8182"
      WEB_HTTP_PROTOCOL_PATH: "/api/dsp"
      WEB_HTTP_CATALOG_PORT: "8184"
      WEB_HTTP_CATALOG_PATH: "/api/catalog"
      WEB_HTTP_CATALOG_AUTH_TYPE: "tokenbased"
      WEB_HTTP_CATALOG_AUTH_KEY: "password"
      WEB_HTTP_VERSION_PORT: "8185"
      WEB_HTTP_VERSION_PATH: "/api/version"
      EDC_PARTICIPANT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_ISSUER_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_DID_WEB_USE_HTTPS: "false"
      EDC_IAM_STS_PRIVATEKEY_ALIAS: "did:web:provider-identityhub:7093-alias"
      EDC_IAM_STS_PUBLICKEY_ID: "did:web:provider-identityhub:7093#key-1"
      EDC_DSP_CALLBACK_ADDRESS: "http://provider-catalogserver:8182/api/dsp"
      EDC_CATALOG_CACHE_EXECUTION_DELAY_SECONDS: "5"
      EDC_CATALOG_CACHE_EXECUTION_PERIOD_SECONDS: "10"
      EDC_MVD_PARTICIPANTS_LIST_FILE: "/app/participants.json"
      EDC_MANAGEMENT_CONTEXT_ENABLED: "true"
      EDC_RUNTIME_ID: "provider-catalogserver-runtime"
      EDC_VAULT_HASHICORP_URL: "http://vault:8200"
      EDC_VAULT_HASHICORP_TOKEN: "root"
      EDC_DATASOURCE_DEFAULT_URL: "jdbc:postgresql://postgres-provider:5432/provider"
      EDC_DATASOURCE_DEFAULT_USER: "provider"
      EDC_DATASOURCE_DEFAULT_PASSWORD: "provider"
      EDC_SQL_SCHEMA_AUTOCREATE: "true"
      EDC_IAM_STS_OAUTH_TOKEN_URL: "http://provider-identityhub:7096/api/sts/token"
      EDC_IAM_STS_OAUTH_CLIENT_ID: "did:web:provider-identityhub:7093"
      EDC_IAM_STS_OAUTH_CLIENT_SECRET_ALIAS: "did:web:provider-identityhub:7093-sts-client-secret"
    depends_on:
      provider-identityhub:
        condition: service_healthy
      postgres-provider:
        condition: service_healthy
      vault:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8180/api/check/health"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  postgres-consumer-data:
  postgres-provider-data:
  postgres-issuer-data:

networks:
  default:
    name: mvd-network
